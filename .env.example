# The URL of the Devserver for the vite proxy during development
VITE_BACKEND_URL=http://localhost:8237

# The version of the UI to be displayed in the UI
VITE_UI_VERSION=0.0.0

# Optional: override API origin for cross-origin deployments (e.g. https://backend.test.com)
VITE_API_BASE_URL=

# URL of the analytics server
VITE_ANALYTICS_SERVER_URL=

# Optional local-dev only: forwarded by the Vite proxy to VITE_BACKEND_URL.
# Use this to test a local UI against an SSO-only staging server.
# Never commit real cookie or CSRF values.
DEV_PROXY_COOKIE=
DEV_PROXY_CSRF_TOKEN=